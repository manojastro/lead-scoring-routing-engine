# File: .env.example
# Copy to .env and fill in real values. NEVER commit .env.

# ---- App / MLflow registry ----
LOG_LEVEL=INFO
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_NAME=lead-quality-classifier
MODEL_STAGE=Production

# ---- Webhook security (openssl rand -hex 32) ----
LEAD_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---- Salesforce (username/password/security-token flow) ----
SALESFORCE_USERNAME=integrations@yourorg.com
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_DOMAIN=login
SALESFORCE_SENIOR_REP_QUEUE_DEVELOPER_NAME=Senior_Reps

# ---- Snowflake (nurture write-through + batch scorer) ----
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=svc_lead_engine
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=LEADS_WRITER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CRM
SNOWFLAKE_SCHEMA_NAME=LEADS
SNOWFLAKE_LOW_PRIORITY_TABLE=LOW_PRIORITY_LEADS

# ---- Routing resilience tuning (optional; sane defaults below) ----
SF_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_S=0.25
RETRY_MAX_DELAY_S=8.0
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_TIMEOUT_S=30
